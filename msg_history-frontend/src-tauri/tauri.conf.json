{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "msg_history-frontend",
  "version": "0.1.0",
  "identifier": "msghistory.ru",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3007",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "msg_history-frontend",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://10.11.207.23:8090 http://10.11.207.23:9000; img-src 'self' http://10.11.207.23:9000"
    }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
